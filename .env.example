PORT=3000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# --- LOCAL DEVELOPMENT ---
# Uses SQLite when DATABASE_URL is not set
DATABASE_PATH=./data/xaccess.sqlite

# --- PRODUCTION (Render / Railway / Supabase) ---
# Set DATABASE_URL to your PostgreSQL connection string.
# Render Blueprint (render.yaml) provisions Postgres and wires DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- PAYSTACK (utility subscription checkout; NGN only) ---
# Secret key must stay on the server only. Get keys from https://dashboard.paystack.com/
# PAYSTACK_SECRET_KEY=sk_test_...
# Optional: override callback URL for hosted checkout (otherwise dashboard default is used)
# PAYSTACK_CALLBACK_URL=https://your-api.example.com/api/v1/...

# --- DEVICE WEBSOCKET (local / on-prem only) ---
# Render does not expose port 7788; set DISABLE_DEVICE_WS=true in cloud.
# DISABLE_DEVICE_WS=true
# DEVICE_WS_PORT=7788
